# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.test-artifacts/

# next.js
/.next*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local Codex preview logs
.codex-dev.*.log

# local source data contains sensitive financial and personal data
/private_source_data/

# vercel
.vercel

# local Supabase CLI state
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
